  "tokenColors": [
    {
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.preprocessor",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#b18219"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#778e95",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.language",
        "meta.diff",
        "punctuation.definition.from-file.diff",
        "punctuation.definition.to-file.diff",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#7a9417"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#388de4"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#388de4"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.alignas",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.noexcept",
        "keyword.operator.sizeof",
        "keyword.operator.type.asserts",
        "keyword.operator.typeid",
        "keyword.operator.wordlike",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f04a91"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#778e96"
      }
    },
    {
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#f04a91"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#7f7fe3"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#df654a"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#b5cccc",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#b5cccc",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#b5cccc"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#fc6a5d"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string"
      ],
      "settings": {
        "foreground": "#e85e37"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#41a1c0"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7f7fe3"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#5dd8ff"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#7f7fe3"
      }
    },
    {
      "scope": [
        "meta.definition.variable",
        "support.type.property-name",
        "support.variable",
        "variable"
      ],
      "settings": {
        "foreground": "#28998d"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed.diff"
      ],
      "settings": {
        "foreground": "#308fd9"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted.diff"
      ],
      "settings": {
        "foreground": "#ff8f89"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted.diff"
      ],
      "settings": {
        "foreground": "#8ba400"
      }
    }
