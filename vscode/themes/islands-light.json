  "tokenColors": [
    {
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.preprocessor",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#72620d",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#636363",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.language",
        "meta.diff",
        "punctuation.definition.from-file.diff",
        "punctuation.definition.to-file.diff",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#871094",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#00627a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#00627a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.alignas",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.noexcept",
        "keyword.operator.sizeof",
        "keyword.operator.type.asserts",
        "keyword.operator.typeid",
        "keyword.operator.wordlike",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#0033b3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0b63b7",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#1750eb",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#244bfc",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string"
      ],
      "settings": {
        "foreground": "#037313",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0033b3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#016d78",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.definition.variable",
        "support.type.property-name",
        "support.variable",
        "variable"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#871094",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed.diff"
      ],
      "settings": {
        "foreground": "#063fdb",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted.diff"
      ],
      "settings": {
        "foreground": "#c51412",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted.diff"
      ],
      "settings": {
        "foreground": "#037313",
        "fontStyle": ""
      }
    }
