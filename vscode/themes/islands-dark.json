  "tokenColors": [
    {
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.preprocessor",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#b3ae60"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8c9097",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.language",
        "meta.diff",
        "punctuation.definition.from-file.diff",
        "punctuation.definition.to-file.diff",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#c77dbb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#56a8f5"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#57aaf7"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.alignas",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.noexcept",
        "keyword.operator.sizeof",
        "keyword.operator.type.asserts",
        "keyword.operator.typeid",
        "keyword.operator.wordlike",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#cf8e6d"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#568cf9"
      }
    },
    {
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2aacb8"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#bcbec4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#bcbec4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#42c3d4"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string"
      ],
      "settings": {
        "foreground": "#6aab73"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d5b778"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#16baac"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "meta.definition.variable",
        "support.type.property-name",
        "support.variable",
        "variable"
      ],
      "settings": {
        "foreground": "#bcbec4"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed.diff"
      ],
      "settings": {
        "foreground": "#3d96d7"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted.diff"
      ],
      "settings": {
        "foreground": "#fc555d"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted.diff"
      ],
      "settings": {
        "foreground": "#649f36"
      }
    }
