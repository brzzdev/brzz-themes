  "tokenColors": [
    {
      "scope": [
        "entity.name.function.decorator",
        "entity.name.function.preprocessor",
        "entity.other.attribute-name",
        "keyword.control.directive",
        "meta.decorator",
        "meta.preprocessor",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#e6c08a"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a3a3a3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#ffcb8f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.alignas",
        "keyword.operator.alignof",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.noexcept",
        "keyword.operator.sizeof",
        "keyword.operator.type.asserts",
        "keyword.operator.typeid",
        "keyword.operator.wordlike",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff8f40"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#39bae6"
      }
    },
    {
      "scope": [
        "markup.fenced_code",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#e6c08a"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d2a6ff"
      }
    },
    {
      "scope": [
        "markup.bold",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f3efe3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f3efe3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#a3a3a3"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#95e6cb"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string"
      ],
      "settings": {
        "foreground": "#aad94c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#39bae6"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#59c2ff"
      }
    },
    {
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#85d0ff"
      }
    },
    {
      "scope": [
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#39bae6"
      }
    },
    {
      "scope": [
        "meta.definition.variable",
        "support.type.property-name",
        "support.variable",
        "variable"
      ],
      "settings": {
        "foreground": "#f3efe3"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#59c2ff",
